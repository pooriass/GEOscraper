library(GEOscraper)
term <- c('(non small cell lung cancer)')
ids <- FindGSE(Search_Term = term, Organism = 'Homo sapiens', Study_type = 'Expression profiling by high throughput sequencing', max_result = 2000)
library(rvest)
library(httr)
library(xml2)
library(retry)
library(tidyverse)
library(stringr)
term <- c('(non small cell lung cancer)')
ids <- FindGSE(Search_Term = term, Organism = 'Homo sapiens', Study_type = 'Expression profiling by high throughput sequencing', max_result = 2000)
ids
perioud <- seq(1, length(ids), 20)
results_list <- list()
for ( i in 1:length(perioud)){
id <- perioud[i]:(perioud[i]+19)
results <- GEOscrap(GSE = ids[id], attr = 'radiology' )
results_list[[i]] <- results
}
View(results_list)
setwd('D:/Research/LUAD and radiogenomics')
save.image()
save.image(''D:/Research/LUAD and radiogenomics'')
save.image('D:/Research/LUAD and radiogenomics')
final_result  <- rbind(data.frame(), results_list[[1]])
for (i in 1:length(results_list)){
final_result  <- rbind(final_result, results_list[[i]])
}
View(final_result)
unique(final_result$GSE_ID)
final_result
write.csv(final_result ,'D:/Research/LUAD and radiogenomics/final_result.csv')
# getting clinical data for TCGA-LIHC cohort -------------------
clinical_LIHC <- GDCquery_clinic("TCGA-LIHC")
library(TCGAbiolinks)
# getting clinical data for TCGA-LIHC cohort -------------------
clinical_LIHC <- GDCquery_clinic("TCGA-LIHC")
any(colnames(clinical_LIHC) %in% c("vital_status", "days_to_last_follow_up", "days_to_death"))
which(colnames(clinical_LIHC) %in% c("vital_status", "days_to_last_follow_up", "days_to_death"))
clinical_LIHC[,c(9,39,45)]
# looking at some variables associated with survival
table(clinical_LIHC$vital_status)
# change certain values the way they are encoded
clinical_LIHC$deceased <- ifelse(clinical_LIHC$vital_status == "Alive", FALSE, TRUE)
# create an "overall survival" variable that is equal to days_to_death
# for dead patients, and to days_to_last_follow_up for patients who
# are still alive
clinical_LIHC $overall_survival <- ifelse(clinical_LIHC$vital_status == "Alive",
clinical_LIHC$days_to_last_follow_up,
clinical_LIHC$days_to_death)
# build a query to get gene expression data for entire cohort
query_LIHC_all = GDCquery(
project = "TCGA-LIHC",
data.category = "Transcriptome Profiling", # parameter enforced by GDCquery
experimental.strategy = "miRNA-Seq",
workflow.type = "BCGSC miRNA Profiling",
sample.type = "Solid Tissue Normal",
access = "open")
library(TCGAbiolinks)
output_LIHC <- getResults(query_LIHC_all)
# get primary tissue sample barcodes
normal <- output_LIHC$cases
query_LIHC_normal = GDCquery(
project = "TCGA-LIHC",
data.category = "Transcriptome Profiling", # parameter enforced by GDCquery
experimental.strategy = "miRNA-Seq",
data.type = 'miRNA Expression Quantification',
workflow.type = "BCGSC miRNA Profiling",
sample.type = "Solid Tissue Normal",
access = "open",
barcode = normal)
# download data
GDCdownload(query_LIHC_normal)
TCGA_LIHC_data <- GDCprepare(query_LIHC_normal, summarizedExperiment = TRUE)
TCGA_LIHC_data
View(TCGA_LIHC_data)
express_data <- TCGA_LIHC_data[,grep('read_count',colnames(TCGA_LIHC_data))]
View(express_data)
express_data <- TCGA_LIHC_data[,c(grep('read_count',colnames(TCGA_LIHC_data)), 1 ) ]
c(grep('read_count',colnames(TCGA_LIHC_data)), 1 )
express_data <- TCGA_LIHC_data[,c(1,grep('read_count',colnames(TCGA_LIHC_data)) ) ]
library(tidyverse)
express_data <- column_to_rownames(express_data,'miRNA_ID')
express_data_normal <- column_to_rownames(express_data,'miRNA_ID')
